# 后端本地开发环境变量（容器内由 docker-compose 注入，无需此文件）
# 仅在不使用 Docker、本地直接跑 uvicorn 时使用
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coderag
POSTGRES_USER=coderag
POSTGRES_PASSWORD=coderag

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=coderag
MINIO_SECRET_KEY=coderag123
MINIO_SECURE=false

MILVUS_HOST=localhost
MILVUS_PORT=19530

ES_URL=http://localhost:9200

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- M44 ModelRouter：三档端点路由（默认空 = 三档全用上面 LLM_*）----
# 每档可独立覆盖 base_url/api_key/model；私有化示例（routing/extraction 本地 vLLM）：
# MODEL_ROUTES={"routing":{"base_url":"http://localhost:8000/v1","api_key":"EMPTY","model":"qwen2.5-7b-instruct"},"extraction":{"base_url":"http://localhost:8000/v1","api_key":"EMPTY","model":"qwen2.5-14b-instruct"}}
# 逐档实测：uv run python scripts/llm_ping.py --tier routing
MODEL_ROUTES=

EMBEDDING_PROVIDER=api
MODEL_SERVER_URL=http://localhost:8100

# Reranker 精排（可选；RERANKER_API_KEY 留空则复用 EMBEDDING_API_KEY）
# 注：硅基流动无 bge-reranker-base，COARSE 留空走单阶段精排
RERANK_ENABLED=true
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_COARSE_MODEL=
RERANKER_FINE_MODEL=BAAI/bge-reranker-v2-m3
