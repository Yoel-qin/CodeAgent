# ===================================================================
# CodeRAG 环境变量（compose + 后端共用）
# 用法：cp .env.example .env，然后按需修改
# ===================================================================

# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_DB=coderag
POSTGRES_USER=coderag
POSTGRES_PASSWORD=coderag
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=coderag
MINIO_ROOT_PASSWORD=coderag123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Elasticsearch ----
ES_PORT=9200

# ---- Milvus ----
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=8001

# ---- 后端 / 前端 / Nginx ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80
MODEL_SERVER_PORT=8100

# ---- LLM（默认走 DeepSeek API；切换供应商改这里）----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx                # 必填：填入你的 DeepSeek / 阿里云百炼 / 硅基流动 Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- M44 ModelRouter：三档端点路由（默认空 = 三档全用上面 LLM_*）----
# 每档可独立覆盖 base_url/api_key/model；私有化示例（routing/extraction 本地 vLLM）：
# MODEL_ROUTES={"routing":{"base_url":"http://localhost:8000/v1","api_key":"EMPTY","model":"qwen2.5-7b-instruct"},"extraction":{"base_url":"http://localhost:8000/v1","api_key":"EMPTY","model":"qwen2.5-14b-instruct"}}
# 逐档实测：uv run python scripts/llm_ping.py --tier routing
MODEL_ROUTES=

# ---- 嵌入/重排部署形态 ----
# api   = 走兼容 API（默认，无需本地 GPU）
# local = 走本地 model_server（需启用 gpu profile）
EMBEDDING_PROVIDER=api
MODEL_SERVER_URL=http://model_server:8100

# ---- Embedding API (OpenAI 兼容 /embeddings；向量召回路径A) ----
# 默认硅基流动 BGE-M3(1024d，有免费额度)；阿里云百炼/OpenAI 同样兼容
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3

# ---- Reranker 精排（设计 §11.5/11.6）----
# 走 OpenAI 兼容 /rerank 端点（SiliconFlow/Cohere 风格）。
# RERANKER_API_KEY 留空则复用 EMBEDDING_API_KEY（同一供应商）。
# RERANK_ENABLED=false 或无 Key → 管道跳过精排，退回 RRF 排序（不报错）。
# 注：硅基流动无独立轻量 bge 粗排模型（bge-reranker-base 不存在），
# 故 RERANKER_COARSE_MODEL 留空 → 单阶段精排（v2-m3）。
RERANK_ENABLED=true
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=sk-xxx
RERANKER_COARSE_MODEL=
RERANKER_FINE_MODEL=BAAI/bge-reranker-v2-m3

# ---- M45 RBAC（默认 off：单用户透传零鉴权）----
# RBAC_ENABLED=true
# JWT_SECRET=change-me-to-a-long-random-string   # on 时必填（on 且空 = startup fail-fast）
# JWT_EXPIRE_MINUTES=720

