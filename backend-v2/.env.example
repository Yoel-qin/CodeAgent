# 与根 .env 变量名兼容；POSTGRES_DB 必须保持 coderag_v2（根 .env 是旧库 coderag，
# env_file=(".env","../.env") 中本文件目录下的 .env 优先级更高，覆盖之）
POSTGRES_DB=coderag_v2
# 其余 PG/Redis/Milvus/ES/LLM 变量缺省时回落根 .env / 代码默认值
REPOS_ROOT=../data/repo
DEFAULT_REPO=rocketmq

# ── V2-M9 可选开关（默认全关 = 零行为变更）──
# RBAC 用户鉴权：on 时全部 API 需 Bearer JWT（public：/health、/v1、/v1/auth/login）；
# JWT_SECRET 在 RBAC_ENABLED=1 时必填（空 → startup fail-fast）。用户用 scripts/create_user.py 建。
#RBAC_ENABLED=0
#JWT_SECRET=
# WEB_SEARCH 联网检索（JSON 数组；空/off/不可达 → web intent 落 retrieve 兜底不崩）：
# [{"name":"search","url":"http://host/mcp","transport":"streamable_http"}]
#WEB_MCP_SERVERS=

# 图片视觉描述（真实库验证 T4-1：图片型 docx 截图对检索可见；默认 off）
# VISION_DESC_ENABLED=true
# VISION_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
# VISION_BASE_URL=          # 空 → 回落 EMBEDDING_BASE_URL（SiliconFlow 同服务商）
# VISION_API_KEY=           # 空 → 回落 EMBEDDING_API_KEY
# VISION_MAX_IMAGES_PER_DOC=50
